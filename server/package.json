{
  "name": "ttearn-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TTEarn 后端(api / admin / stats 三服务,共用 Postgres + Redis)",
  "scripts": {
    "migrate": "node src/shared/migrate.js",
    "start:api": "node src/api/index.js",
    "start:admin": "node src/admin/index.js",
    "start:stats": "node src/stats/index.js",
    "dev:api": "node --watch src/api/index.js",
    "dev:admin": "node --watch src/admin/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1"
  }
}
