# 服务端口
PORT=3000

# 允许的前端来源(CORS),多个用逗号分隔
CORS_ORIGIN=https://tg.ttgame.fun

# 会话 token 签名密钥(生产必须改成强随机,如 openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# Telegram Bot Token(校验小程序 initData 用;留空则跳过校验,仅开发)
TELEGRAM_BOT_TOKEN=

# TON 打款热钱包助记词(生产用;留空则提现只落 pending 不真实打款)
# ⚠️ 绝不要提交真实助记词到仓库
TON_WALLET_MNEMONIC=
TON_NETWORK=mainnet
# toncenter API key(查余额/发交易)
TONCENTER_API_KEY=
