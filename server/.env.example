# ===== 三服务端口 =====
API_PORT=3001
ADMIN_PORT=3002
STATS_PORT=3003

# 前端 / 后台 允许来源(CORS)
CORS_ORIGIN=https://tg.ttgame.fun
ADMIN_ORIGIN=https://tgadmin.ttgame.fun

# 用户会话签名密钥(强随机)
JWT_SECRET=change-me
# 后台会话签名密钥(强随机,和 JWT 分开)
ADMIN_SECRET=change-me-admin
# 后台登录账号
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# Telegram Bot Token(initData 校验;留空则开发放行)
TELEGRAM_BOT_TOKEN=

# TON 打款(留空则提现只落 pending)
TON_WALLET_MNEMONIC=
TON_NETWORK=mainnet
TONCENTER_API_KEY=

# DATABASE_URL / REDIS_URL 从上级目录的 db.env / cache.env 自动加载(不要写在这里)
