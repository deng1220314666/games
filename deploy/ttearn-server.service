# systemd 服务:后端常驻 + 崩溃自启
# 放到 /etc/systemd/system/ttearn-server.service
[Unit]
Description=TTEarn backend API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/ttearn-server/server
# dotenv 从 WorkingDirectory 读 .env,secrets 都放那份 .env
# ExecStart 的 node 路径由 setup.sh 按实际 which node 写入
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
User=root
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
